{
  "name": "ocodista-plugins",
  "owner": {
    "name": "ocodista",
    "url": "https://ocodista.com"
  },
  "plugins": [
    {
      "name": "claude-usage",
      "source": "./",
      "description": "Real-time token usage monitor with interactive dashboard",
      "version": "1.0.0",
      "author": {
        "name": "ocodista",
        "url": "https://ocodista.com"
      },
      "repository": "https://github.com/ocodista/claude-usage",
      "license": "MIT",
      "keywords": ["tokens", "usage", "dashboard", "analytics", "cost"],
      "tags": ["monitoring", "analytics", "dashboard", "tokens"],
      "category": "analytics",
      "installation": "npm",
      "commands": {
        "start": {
          "description": "Start the dashboard server",
          "command": "bun run src/server/index.ts"
        },
        "stats": {
          "description": "Show quick token statistics",
          "command": "bun run src/cli.ts stats"
        },
        "open": {
          "description": "Open dashboard in browser",
          "command": "bun run src/cli.ts open"
        }
      }
    }
  ]
}
