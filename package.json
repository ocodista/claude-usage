{
  "name": "@ocodista/claude-usage",
  "version": "1.0.0",
  "description": "Real-time Claude Code token usage monitor with interactive dashboard",
  "type": "module",
  "bin": {
    "claude-code-usage": "./src/cli.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "build": "bun run build.ts",
    "build:client": "bun build src/client/app.tsx --outdir=dist --minify",
    "prepublishOnly": "bun run build:client"
  },
  "keywords": [
    "claude",
    "claude-code",
    "token",
    "usage",
    "monitoring",
    "dashboard",
    "ai",
    "llm"
  ],
  "author": {
    "name": "ocodista",
    "url": "https://ocodista.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ocodista/claude-usage.git"
  },
  "bugs": {
    "url": "https://github.com/ocodista/claude-usage/issues"
  },
  "homepage": "https://ocodista.com/blog/claude-usage",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.6.3"
  }
}
